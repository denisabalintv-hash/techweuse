---
interface Props {
  title: string;
  description: string;
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const currentYear = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · TechWeUse</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header>
      <div class="header-inner">
        <a class="logo" href="/">
          <span class="logo-mark" aria-hidden="true"></span>
          TechWeUse
        </a>
        <nav>
          <a href="/reviews">Reviews</a>
          <a href="/about">About</a>
          <a href="/disclosure">Disclosure</a>
        </nav>
      </div>
    </header>
    <main id="main" class:list={[{ wide }]}>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <p>&copy; {currentYear} TechWeUse. This site contains affiliate links — see our <a href="/disclosure">disclosure</a>.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #fbfbfa;
    --color-surface: #ffffff;
    --color-text: #17171a;
    --color-text-muted: #55555c;
    --color-border: #e8e7e4;
    --color-border-hover: #d3d2ce;
    --color-gaming: #be1868;
    --color-gaming-tint: #fce9f1;
    --color-software: #04704f;
    --color-software-tint: #e3f5ee;
    --font-heading: 'Sora', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --radius: 14px;
    --content-width: 46rem;
  }

  * {
    box-sizing: border-box;
  }

  html {
    color-scheme: light;
  }

  body {
    font-family: var(--font-body);
    background: var(--color-bg);
    color: var(--color-text);
    margin: 0;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.6rem 1rem;
    z-index: 100;
    border-radius: 0 0 8px 0;
  }
  .skip-link:focus {
    left: 0;
  }

  header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .header-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 1.1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .logo-mark {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--color-gaming), var(--color-software));
    flex-shrink: 0;
  }
  header nav {
    display: flex;
    gap: 1.75rem;
  }
  header nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.95rem;
    position: relative;
    padding-bottom: 0.15rem;
    transition: color 0.15s ease;
  }
  header nav a:hover {
    color: var(--color-text);
  }

  main {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  main.wide {
    max-width: 64rem;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    color: var(--color-text);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: 2.1rem;
    font-weight: 800;
    margin: 0 0 1.25rem;
  }
  h2 {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
  }
  h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 1.75rem 0 0.75rem;
  }
  p {
    margin: 0 0 1.25rem;
    color: var(--color-text);
  }
  ul, ol {
    padding-left: 1.3rem;
    margin: 0 0 1.25rem;
  }
  li {
    margin-bottom: 0.6rem;
  }
  a {
    color: var(--color-gaming);
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
  strong {
    font-weight: 700;
  }

  .callout {
    background: var(--color-software-tint);
    border-left: 3px solid var(--color-software);
    padding: 1rem 1.25rem;
    border-radius: 0 10px 10px 0;
    margin: 0 0 1.75rem;
  }
  .callout strong {
    color: var(--color-software);
  }

  footer {
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
  }
  .footer-inner {
    max-width: 64rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  footer a {
    color: var(--color-text-muted);
    text-decoration: underline;
  }
</style>

---
// Hand-built SVG illustration - no stock art, no AI-generated images.
// Depicts a review card, a game controller, and a verified-check badge
// to represent the site's two pillars (software + gaming) and its
// research-first approach.
---
<svg
  class="hero-illustration"
  viewBox="0 0 480 420"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Illustration of a review card, a game controller, and a verified checkmark badge"
>
  <defs>
    <linearGradient id="gamingGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#e0347f" />
      <stop offset="1" stop-color="#8f1257" />
    </linearGradient>
    <linearGradient id="softwareGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0a9468" />
      <stop offset="1" stop-color="#045c40" />
    </linearGradient>
    <filter id="softShadow" x="-40%" y="-40%" width="180%" height="180%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#17171a" flood-opacity="0.13" />
    </filter>
  </defs>

  <!-- decorative floating dots -->
  <circle cx="430" cy="150" r="6" fill="#be1868" opacity="0.25" />
  <circle cx="40" cy="70" r="5" fill="#04704f" opacity="0.25" />
  <circle cx="410" cy="330" r="4" fill="#be1868" opacity="0.3" />

  <!-- main review-card mockup -->
  <g transform="rotate(-4 180 210)" filter="url(#softShadow)">
    <rect x="50" y="115" width="260" height="180" rx="20" fill="#ffffff" stroke="#e8e7e4" stroke-width="1.5" />
    <rect x="76" y="147" width="68" height="22" rx="11" fill="#fce9f1" />
    <text x="110" y="162" font-family="Inter, system-ui, sans-serif" font-size="10" font-weight="700" fill="#be1868" text-anchor="middle" letter-spacing="0.5">GAMING</text>
    <rect x="76" y="188" width="200" height="11" rx="3" fill="#e8e7e4" />
    <rect x="76" y="209" width="170" height="11" rx="3" fill="#e8e7e4" />
    <rect x="76" y="230" width="140" height="11" rx="3" fill="#e8e7e4" />
    <rect x="76" y="260" width="86" height="14" rx="7" fill="#17171a" />
    <text x="119" y="270" font-family="Inter, system-ui, sans-serif" font-size="9" font-weight="700" fill="#ffffff" text-anchor="middle">READ REVIEW</text>
  </g>

  <!-- game controller -->
  <g transform="rotate(10 340 90)" filter="url(#softShadow)">
    <rect x="270" y="55" width="140" height="72" rx="36" fill="url(#gamingGrad)" />
    <rect x="296" y="83" width="20" height="6" rx="3" fill="#ffffff" opacity="0.9" />
    <rect x="303" y="76" width="6" height="20" rx="3" fill="#ffffff" opacity="0.9" />
    <circle cx="378" cy="78" r="7" fill="#ffffff" opacity="0.9" />
    <circle cx="393" cy="93" r="7" fill="#ffffff" opacity="0.75" />
  </g>

  <!-- verified / research badge -->
  <g transform="rotate(-6 96 330)" filter="url(#softShadow)">
    <circle cx="96" cy="330" r="42" fill="url(#softwareGrad)" />
    <path d="M78 331 L90 343 L116 314" stroke="#ffffff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none" />
  </g>
</svg>

<style>
  .hero-illustration {
    width: 100%;
    height: auto;
    max-width: 26rem;
  }
</style>

---
import type { Review } from '../data/reviews';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  review: Review;
}
const { review } = Astro.props as Props;
---
<a class="card" href={review.href} data-category={review.category}>
  <span class="tag">
    <CategoryIcon category={review.category} />
    {review.category}
  </span>
  <h3>{review.title}</h3>
  <p>{review.description}</p>
  <span class="read-more">Read it &rarr;</span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    border-color: var(--color-border-hover);
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
    padding: 0.3rem 0.7rem 0.3rem 0.55rem;
  }
  .card[data-category='Gaming'] .tag {
    color: var(--color-gaming);
    background: var(--color-gaming-tint);
  }
  .card[data-category='Software'] .tag {
    color: var(--color-software);
    background: var(--color-software-tint);
  }
  .card h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.08rem;
    line-height: 1.4;
    color: var(--color-text);
  }
  .card p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    flex-grow: 1;
  }
  .read-more {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }
</style>

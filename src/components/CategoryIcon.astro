---
interface Props {
  category: 'Gaming' | 'Software';
}
const { category } = Astro.props as Props;
---
{category === 'Gaming' ? (
  <svg class="cat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="2" y="7" width="20" height="11" rx="5.5" fill="currentColor" opacity="0.16" />
    <rect x="6" y="11.5" width="6" height="2" rx="1" fill="currentColor" />
    <rect x="8" y="9.5" width="2" height="6" rx="1" fill="currentColor" />
    <circle cx="16" cy="10.5" r="1.4" fill="currentColor" />
    <circle cx="19" cy="13.5" r="1.4" fill="currentColor" />
  </svg>
) : (
  <svg class="cat-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.16" />
    <circle cx="8.5" cy="9" r="1.6" fill="currentColor" />
    <rect x="8.5" y="10.6" width="0" height="0" />
    <line x1="8.5" y1="6" x2="8.5" y2="7.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <line x1="8.5" y1="10.6" x2="8.5" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <circle cx="15.5" cy="15" r="1.6" fill="currentColor" />
    <line x1="15.5" y1="6" x2="15.5" y2="13.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    <line x1="15.5" y1="16.6" x2="15.5" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
)}

<style>
  .cat-icon {
    width: 1em;
    height: 1em;
    display: inline-block;
    vertical-align: -0.15em;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import ReviewCard from '../components/ReviewCard.astro';
import HeroIllustration from '../components/HeroIllustration.astro';
import { reviews } from '../data/reviews';

const latest = reviews.slice(0, 6);
---
<Layout
  title="Home"
  description="Software, tools, and digital gaming - honest research, hands-on testing where we can get it, and no invented claims."
  wide
>
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-text">
      <h1>Software and gaming, actually explained.</h1>
      <p class="lede">
        We dig into how software, subscriptions, and digital tools
        actually work before we recommend them — hands-on testing
        wherever we can genuinely get it, thorough research from
        official sources and verified reports everywhere else. We tell
        you which is which, not repackaged marketing copy.
      </p>
      <div class="hero-cta">
        <a class="btn btn-gaming" href="/reviews">Browse gaming reviews</a>
        <a class="btn btn-software" href="/reviews">Browse software reviews</a>
      </div>
    </div>
    <div class="hero-art" aria-hidden="true">
      <HeroIllustration />
    </div>
  </section>

  <section class="latest">
    <div class="latest-header">
      <h2>Latest reviews</h2>
      <a class="see-all" href="/reviews">See all &rarr;</a>
    </div>
    <div class="grid">
      {latest.map((review) => <ReviewCard review={review} />)}
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    max-width: 68rem;
    margin: 0 auto 4rem;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    text-align: center;
  }
  .hero-text {
    max-width: 34rem;
  }
  .hero-art {
    width: 100%;
    max-width: 22rem;
    display: flex;
    justify-content: center;
  }
  @media (min-width: 880px) {
    .hero {
      flex-direction: row;
      text-align: left;
      align-items: center;
      justify-content: space-between;
    }
    .hero-cta {
      justify-content: flex-start;
    }
  }
  .hero-glow {
    position: absolute;
    inset: -4rem -2rem auto -2rem;
    height: 20rem;
    z-index: -1;
    background:
      radial-gradient(circle at 20% 30%, rgba(190, 24, 104, 0.14), transparent 60%),
      radial-gradient(circle at 80% 20%, rgba(4, 112, 79, 0.14), transparent 55%);
    filter: blur(10px);
  }
  .hero h1 {
    font-size: 2.6rem;
    margin-bottom: 1.1rem;
  }
  .lede {
    font-size: 1.08rem;
    color: var(--color-text-muted);
    margin: 0 0 2rem;
  }
  .hero-cta {
    display: flex;
    gap: 0.85rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.65rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn-gaming {
    background: var(--color-gaming);
    color: #fff;
  }
  .btn-software {
    background: #fff;
    color: var(--color-software);
    border-color: var(--color-software);
  }
  .latest-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .latest-header h2 {
    margin: 0;
  }
  .see-all {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text-muted);
  }
  .see-all:hover {
    color: var(--color-text);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { reviews } from '../../data/reviews';
---
<Layout
  title="Reviews"
  description="Hands-on reviews and comparisons of software, tools, and digital gaming platforms."
  wide
>
  <div class="intro">
    <h1>Reviews</h1>
    <p>
      Hands-on testing where we can genuinely get it, thorough research
      from official sources and independent test results where we can't
      — each review says which. See our
      <a href="/disclosure">disclosure</a> for how we handle affiliate
      links.
    </p>
  </div>

  <div class="filters" role="group" aria-label="Filter reviews by category">
    <button type="button" class="filter active" data-filter="all">All</button>
    <button type="button" class="filter" data-filter="Gaming">Gaming</button>
    <button type="button" class="filter" data-filter="Software">Software</button>
  </div>

  <div class="grid" id="review-grid">
    {reviews.map((review) => <ReviewCard review={review} />)}
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('#review-grid .card');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      button.classList.add('active');
      const filter = button.dataset.filter;
      cards.forEach((card) => {
        const matches = filter === 'all' || card.dataset.category === filter;
        card.style.display = matches ? '' : 'none';
      });
    });
  });
</script>

<style>
  .intro {
    max-width: 40rem;
    margin: 0 0 2rem;
  }
  .intro p {
    color: var(--color-text-muted);
    margin: 0;
  }
  .filters {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .filter {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter:hover {
    border-color: var(--color-border-hover);
  }
  .filter.active {
    background: var(--color-text);
    border-color: var(--color-text);
    color: #fff;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

---
import Layout from '../../layouts/Layout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { reviews } from '../../data/reviews';
---
<Layout
  title="Reviews"
  description="Hands-on reviews and comparisons of software, tools, and digital gaming platforms."
  wide
>
  <div class="intro">
    <h1>Reviews</h1>
    <p>
      Hands-on testing where we can genuinely get it, thorough research
      from official sources and independent test results where we can't
      — each review says which. See our
      <a href="/disclosure">disclosure</a> for how we handle affiliate
      links.
    </p>
  </div>
  <div class="grid">
    {reviews.map((review) => <ReviewCard review={review} />)}
  </div>
</Layout>

<style>
  .intro {
    max-width: 40rem;
    margin: 0 0 2.5rem;
  }
  .intro p {
    color: var(--color-text-muted);
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
